# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_DATABASE=thread
DB_TABLE=machine_test

# Serial Port
SERIAL_PORT=/dev/ttyACM0

# MQTT Configuration
MQTT_SERVER=mqtt.anc.idea8.cloud
MQTT_PORT=8883
MQTT_USERNAME=backend
MQTT_PASSWORD=your_mqtt_password_here

# Seam length and stitch width offsets
SEAM_LENGTH_OFFSET=-2.1
STITCH_WIDTH_OFFSET=-1.8

# ROI Settings
ROI_ENABLED=true
ROI_X_MIN=100
ROI_X_MAX=1270
ROI_Y_MIN=300
ROI_Y_MAX=760
